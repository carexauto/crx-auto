# --- Email delivery ---

# Web3Forms (default). Create a free access key at https://web3forms.com using
# info@crx.ge as the destination email. Called from the browser, so it must be
# public (NEXT_PUBLIC_*). Web3Forms protects it with spam filtering + honeypot.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# --- Optional: Resend (server-side alternative for domain-verified sending) ---
# Only used by the /api/quote route if you switch back to server-side delivery.
RESEND_API_KEY=
QUOTE_TO_EMAIL=info@crx.ge
QUOTE_FROM_EMAIL=Carex Auto Quotes <quotes@crx.ge>

# Public site URL, used for canonical/sitemap/robots. No trailing slash.
# In Vercel this can be left blank to fall back to the deployment URL.
NEXT_PUBLIC_SITE_URL=https://carex.auto

# --- Optional: bot protection (add before public promotion) ---
# Cloudflare Turnstile keys. Leave blank to disable the challenge for now.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
